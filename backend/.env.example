# Copy to .env and fill in real values before running the backend.

# --- Core ---
DATABASE_URL=sqlite:///./data/app.db
SECRET_KEY=change-this-to-a-long-random-string
# 24 saat - saha ekibi gün içinde tekrar giriş yapmak zorunda kalmasın.
ACCESS_TOKEN_EXPIRE_MINUTES=1440
CORS_ORIGINS=*

# --- Stock module ---
# Days before SKT (son kullanma tarihi) to start warning employees.
SKT_WARNING_DAYS=90

# --- Employee check-in module (tab 4) ---
# Folder where morning check-in photos are stored.
CHECKIN_PHOTOS_FOLDER=./data/checkins

# --- Invoice module ---
# Folder that is watched for new invoice PDFs. Drop a PDF here and it gets
# parsed automatically (fatura no, fatura tarihi, vade tarihi, tutar).
INVOICE_FOLDER=./data/invoices
# How many days before vade tarihi employees should start getting reminders.
INVOICE_REMINDER_DAYS=7

# --- Clinical assistant (tab 3) ---
# Folder of clinical study PDFs (literature) that gets indexed for RAG.
CLINICAL_DOCS_FOLDER=./data/clinical_docs
VECTOR_DB_DIR=./data/vectorstore

# Qwen is served through any OpenAI-compatible endpoint. Examples:
#  - Local Ollama:      QWEN_BASE_URL=http://localhost:11434/v1  QWEN_API_KEY=ollama
#  - Alibaba DashScope:  QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
#  - Self-hosted vLLM:  QWEN_BASE_URL=http://localhost:8000/v1
QWEN_BASE_URL=http://localhost:11434/v1
QWEN_API_KEY=ollama
QWEN_MODEL=qwen2.5:14b-instruct
# Assistant response time is dominated by the answer-generation call. These are
# the config-level levers; see POST /assistant/timing-diagnostics to measure
# which stage actually dominates before changing them.
#  - QWEN_MAX_TOKENS: answer length cap; time grows with generated tokens.
#  - QWEN_TIMEOUT_SECONDS: the OpenAI client otherwise waits 10 minutes.
#  - QWEN_DISABLE_THINKING: Qwen3 models reason at length before answering,
#    which multiplies latency. Only set true if the model accepts the flag.
# Relevance cutoff (L2 distance) for clinical-document chunks. Measured in
# production: a covered question scores 0.595-0.672, an uncovered one
# 1.142-1.235. Raise to admit more chunks, lower to filter harder.
DOCUMENT_MAX_DISTANCE=0.95

QWEN_MAX_TOKENS=1200
QWEN_TIMEOUT_SECONDS=60
QWEN_DISABLE_THINKING=false

# PubMed (NCBI E-utilities). No key required, but an email + free API key
# raises your rate limit from 3 to 10 req/s. Get a key at ncbi.nlm.nih.gov.
PUBMED_EMAIL=your-email@example.com
PUBMED_API_KEY=

# --- EvoBulut entegrasyonu (satış faturalarını otomatik çekmek için) ---
EVOBULUT_USERNAME=
EVOBULUT_PASSWORD=
EVOBULUT_APP_NAME=7ai-saha-uygulamasi

# --- E-posta bildirimleri (günlük vade/SKT özeti) ---
# Boş bırakılırsa e-posta gönderimi sessizce devre dışı kalır.
#
# ÖNERİLEN: Resend (HTTPS API). Railway'in Hobby planı giden SMTP portlarını
# tamamen engellediğinden bulutta SMTP çalışmaz.
RESEND_API_KEY=
# Gönderen adresi - Resend'de doğrulanmış alan adınıza ait olmalı.
SMTP_FROM=bildirim@sirketiniz.com

# Yedek yol: SMTP'nin açık olduğu ortamlar için (kendi sunucunuz vb.)
# Microsoft 365 örneği: smtp.office365.com / 587 / TLS
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=true
# Günlük özetin gönderileceği saat (Europe/Istanbul, 0-23).
DIGEST_HOUR=8
# E-postadaki "Uygulamayı Aç" bağlantısının hedefi.
APP_PUBLIC_URL=https://saha.7medikal.com

# --- Backups ---
# Weekly automated backups (DB + all uploaded files) as .zip, since Railway's
# Hobby plan doesn't include native volume backups. Folder for the zips and
# how many to keep before pruning the oldest.
BACKUP_DIR=./data/backups

# --- Off-site backup copies (S3-compatible) ---
# Without these, backups exist only on the Railway disk - the one place that
# also disappears if the disk or the service does. Any S3-compatible provider
# works; Cloudflare R2 is the cheapest fit here (10 GB free, no egress fees).
# Leave blank to keep backups local only.
BACKUP_S3_ENDPOINT=
BACKUP_S3_BUCKET=
BACKUP_S3_ACCESS_KEY=
BACKUP_S3_SECRET_KEY=
BACKUP_S3_REGION=auto
BACKUP_S3_KEEP_COUNT=12
BACKUP_KEEP_COUNT=8
