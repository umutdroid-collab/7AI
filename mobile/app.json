{
  "expo": {
    "name": "7AI Saha Uygulamasi",
    "slug": "7ai-saha-uygulamasi",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "icon": "./assets/icon.png",
    "splash": {
      "backgroundColor": "#0f172a"
    },
    "assetBundlePatterns": ["**/*"],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.sirket.sahauygulamasi",
      "infoPlist": {
        "NSCameraUsageDescription": "Hastane giriş kaydı için fotoğraf çekmek amacıyla kameraya erişim gerekir.",
        "NSLocationWhenInUseUsageDescription": "Check-in yaparken konumunuzu kaydetmek için konum erişimi gerekir."
      }
    },
    "android": {
      "package": "com.sirket.sahauygulamasi",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0f172a"
      },
      "permissions": ["CAMERA", "ACCESS_COARSE_LOCATION", "ACCESS_FINE_LOCATION"]
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "name": "7AI Saha Uygulaması",
      "shortName": "7AI",
      "themeColor": "#0f172a",
      "backgroundColor": "#0f172a",
      "display": "standalone",
      "lang": "tr"
    },
    "plugins": [
      [
        "expo-image-picker",
        {
          "cameraPermission": "Hastane giriş kaydı için fotoğraf çekmek amacıyla kameraya erişim gerekir."
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Hastane giriş kaydı için fotoğraf çekmek amacıyla kameraya erişim gerekir."
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Check-in yaparken konumunuzu kaydetmek için konum erişimi gerekir."
        }
      ]
    ],
    "extra": {
      "apiBaseUrl": "https://api.7medikal.com"
    }
  }
}
