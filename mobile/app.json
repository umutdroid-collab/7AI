{
  "expo": {
    "name": "7AI Saha Uygulamasi",
    "slug": "7ai-saha-uygulamasi",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "splash": {
      "backgroundColor": "#0f172a"
    },
    "assetBundlePatterns": ["**/*"],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.sirket.sahauygulamasi",
      "infoPlist": {
        "NSCameraUsageDescription": "Hastane giriş kaydı için fotoğraf çekmek amacıyla kameraya erişim gerekir."
      }
    },
    "android": {
      "package": "com.sirket.sahauygulamasi",
      "adaptiveIcon": {
        "backgroundColor": "#0f172a"
      },
      "permissions": ["CAMERA"]
    },
    "plugins": [
      [
        "expo-image-picker",
        {
          "cameraPermission": "Hastane giriş kaydı için fotoğraf çekmek amacıyla kameraya erişim gerekir."
        }
      ]
    ],
    "extra": {
      "apiBaseUrl": "http://localhost:8000"
    }
  }
}
